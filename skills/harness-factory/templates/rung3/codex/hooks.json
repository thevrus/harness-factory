{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.harness/hooks/protect-paths.sh\" --agent codex",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.harness/hooks/guard-bash.sh\" --agent codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
