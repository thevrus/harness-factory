{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "merge_risk"],
  "properties": {
    "summary": {"type": "string", "maxLength": 2000},
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "severity", "title", "detail"],
        "properties": {
          "path": {"type": "string", "maxLength": 300},
          "line": {"type": "integer", "minimum": 1},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "title": {"type": "string", "maxLength": 200},
          "detail": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "merge_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "alignment", "impact", "verification", "rollback_cost", "error_detection"],
      "properties": {
        "level": {"type": "string", "enum": ["low", "medium", "high"]},
        "alignment": {"type": "string", "maxLength": 300},
        "impact": {"type": "string", "maxLength": 300},
        "verification": {"type": "string", "maxLength": 300},
        "rollback_cost": {"type": "string", "maxLength": 300},
        "error_detection": {"type": "string", "maxLength": 300}
      }
    }
  }
}
